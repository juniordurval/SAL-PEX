# Neon > Connection details > pooled connection string (solo servidor)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Contraseña de administración fuerte, mínimo 16 caracteres
ADMIN_PASSWORD="CAMBIAR_POR_UNA_CONTRASENA_SEGURA_DE_16_O_MAS"
# Cadena aleatoria de 32+ caracteres (openssl rand -hex 32)
SESSION_SECRET="REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"
# URL oficial solo cuando DNS esté configurado
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
